# LifeQuest — example environment file.
# Copy it and fill in your own values:
#   cp .env.example .env
# Then edit .env. NEVER commit a real .env to git (it holds secrets).
#
# Everything here is OPTIONAL — docker-compose.yml has built-in defaults,
# so `docker compose up -d` works even without a .env file. Set a value
# here only when you want to override the default.

# --- Image tag (which Docker Hub image to run) ---
# staging  -> image built from the staging branch
# latest   -> image built from main (default, production)
# sha-<commit> -> pin one exact build (best for production rollback)
IMAGE_TAG=latest

# --- Host port for the API ---
# The API listens on 8000 inside the container; this is the port on YOUR
# machine/server. Change it if 8000 is already in use.
API_PORT=8000

# --- Database (PostGIS) ---
# The api/worker connect with DATABASE_URL. If you change POSTGRES_PASSWORD,
# update DATABASE_URL to match (same password in both places).
POSTGRES_USER=lifequest
POSTGRES_PASSWORD=lifequest
POSTGRES_DB=lifequest
DATABASE_URL=postgresql+psycopg://lifequest:lifequest@db:5432/lifequest

# --- Auth ---
# Secret used to sign login (JWT) tokens. CHANGE THIS in production to a
# long random string (e.g. `openssl rand -hex 32`). If you change it, all
# users are logged out and must log in again.
JWT_SECRET=dev-jwt-secret-change-me-in-production

# --- Redis (cache + live dots) ---
# Only needed if Redis is NOT the `redis` service in docker-compose.yml
# (e.g. a managed Redis on GCP/AWS/Oracle). Leave commented for compose.
# REDIS_URL=redis://redis:6379/0

# --- Cloudflare Tunnel (OPTIONAL, home lab only) ---
# Needed only when you run with `--profile prod` to expose the API on your
# own domain (e.g. api.example.com). Get the token from the Cloudflare
# dashboard: Zero Trust -> Access -> Tunnels -> your tunnel -> Install.
# Without it, the tunnel container will not start; the rest of the app
# still works on localhost.
# CLOUDFLARE_TUNNEL_TOKEN=
